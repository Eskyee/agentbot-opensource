# ================================================
# DOCKER ENVIRONMENT - SECURE DEFAULTS
# ================================================
# Copy this file to .env.docker and fill in real values
# NEVER commit real secrets to git!

# ================================================
# CORE (Required)
# ================================================
NODE_ENV=development
INTERNAL_API_KEY=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgres://agentbot:devpassword@postgres:5432/agentbot_db
REDIS_URL=redis://redis:6379

# ================================================
# DOMAIN CONFIG
# ================================================
ALLOWED_ORIGINS=http://localhost:3000,https://agentbot.raveculture.xyz
AGENTS_DOMAIN=agents.localhost
NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_API_URL=http://agentbot-api:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENTS_DOMAIN=agents.localhost

# ================================================
# CDP WALLET (Required for wallet operations)
# ================================================
CDP_PROJECT_ID=CHANGE_ME
CDP_API_KEY_ID=CHANGE_ME
CDP_API_KEY_SECRET=CHANGE_ME

# ================================================
# AUTH (Required)
# ================================================
NEXTAUTH_SECRET=CHANGE_ME_MIN_32_CHARS
NEXTAUTH_URL=https://agentbot.raveculture.xyz
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# ================================================
# AI PROVIDER (Bring Your Own Key)
# ================================================
OPENROUTER_API_KEY=CHANGE_ME

# ================================================
# EMAIL (Optional - Resend)
# ================================================
RESEND_API_KEY=CHANGE_ME

# ================================================
# STRIPE (Optional - for payments)
# ================================================
STRIPE_SECRET_KEY=CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# ================================================
# MUX (Optional - for video streaming)
# ================================================
MUX_TOKEN_ID=CHANGE_ME
MUX_TOKEN_SECRET=CHANGE_ME
MUX_SIGNING_SECRET=CHANGE_ME

# ================================================
# DISCORD (Optional - for Discord bot)
# ================================================
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_PUBLIC_KEY=CHANGE_ME
WEBHOOK_API_KEY=CHANGE_ME_STRONG_RANDOM

# ================================================
# WHATSAPP (Optional - for WhatsApp bot)
# ================================================
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_WEBHOOK_SECRET=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME

# ================================================
# SECURITY - DO NOT CHANGE
# ================================================
SKIP_AUTH_FOR_DEMO=false
PRIVATE_MODE=false
INVITE_REQUIRED=false
