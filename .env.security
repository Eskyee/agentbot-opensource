# Security Hardening Configuration

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
AUTH_ATTEMPTS_LIMIT=5
AUTH_ATTEMPT_WINDOW_MINUTES=15

# Request Validation
MAX_REQUEST_SIZE_MB=10
MAX_QUERY_STRING_LENGTH=2048
MAX_BODY_LENGTH_MB=1
REQUEST_TIMEOUT_MS=30000

# Admin Emails (comma-separated, for security dashboard)
ADMIN_EMAILS=admin@agentbot.raveculture.xyz,rbasefm@icloud.com

# Security Logging
LOG_DIR=/var/log/agentbot
LOG_LEVEL=info
SECURITY_LOG_ENABLED=true

# DDoS Protection
ENABLE_DDOS_PROTECTION=true
DDOS_THRESHOLD_REQUESTS=100
DDOS_WINDOW_SECONDS=60

# Bot Detection
ENABLE_BOT_DETECTION=true
BOT_DETECTION_STRICT_MODE=false

# IP Blocking
ENABLE_IP_BLOCKING=true
AUTO_BLOCK_THRESHOLD=3
AUTO_BLOCK_DURATION_HOURS=1

# CORS Security
ALLOWED_ORIGINS=https://agentbot.raveculture.xyz,https://www.agentbot.raveculture.xyz
CORS_CREDENTIALS=true

# HTTPS/SSL
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:
CSP_CONNECT_SRC='self' https://api.stripe.com https://vitals.vercel-insights.com wss: ws:
CSP_FRAME_ANCESTORS='none'

# Secrets Management
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
DATABASE_URL=${DATABASE_URL}
REDIS_URL=${REDIS_URL}

# Security Headers
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"
REFERRER_POLICY=strict-origin-when-cross-origin

# Session Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_MAX_AGE=2592000

# File Upload Security
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,zip,jpg,jpeg,png,gif
MAX_FILE_SIZE_MB=50
SCAN_UPLOADS=true

# API Security
ENABLE_API_KEY_ROTATION=true
API_KEY_ROTATION_DAYS=90
REQUIRE_API_KEY_HTTPS=true

# Monitoring
ENABLE_SECURITY_MONITORING=true
ALERT_EMAIL=security@agentbot.raveculture.xyz
CRITICAL_ALERT_WEBHOOK=${CRITICAL_ALERT_WEBHOOK}

# Feature Flags
ENABLE_2FA=false
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_SIGNING=false
ENABLE_ENCRYPTION_AT_REST=false
