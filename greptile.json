{
  "$schema": "https://greptile.com/schema.json",
  "name": "agentbot",
  "on": ["pull_request", "push"],
  "autoReview": true,
  "autoReviewPriority": "high",
  "blockUntilIndexingComplete": true,
  "maxComments": 10,
  "reviewStatus": "request-changes",
  "ignorePatterns": [
    "node_modules/**",
    "*.lock",
    "package-lock.json",
    "*.svg",
    "*.png",
    "*.jpg"
  ],
  "languages": ["typescript", "javascript", "python"],
  "instructions": "Review code for best practices, security issues, and performance. Focus on the agentbot backend API and OpenClaw deployment logic."
}
