{
  "name": "agentbot",
  "description": "Agentbot OpenClaude profile. Keep secrets in environment variables, never in this file.",
  "provider": "openai-compatible",
  "baseUrl": "https://ai-gateway.vercel.sh/v1",
  "model": "xiaomi/mimo-v2.5-pro",
  "env": {
    "CLAUDE_CODE_USE_OPENAI": "1",
    "OPENAI_BASE_URL": "https://ai-gateway.vercel.sh/v1",
    "OPENAI_MODEL": "xiaomi/mimo-v2.5-pro",
    "OPENAI_API_KEY": "$AI_GATEWAY_API_KEY"
  },
  "commands": {
    "start": "npm run openclaude:agentbot",
    "raw": "npm run openclaude"
  }
}
