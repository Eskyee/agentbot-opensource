# Production Environment Variables
# Sensitive values are injected via Docker secrets
# Never commit actual values to git

NODE_ENV=production
PORT=3001

# Database (password loaded from secret)
DATABASE_URL=postgresql://agentbot:@postgres:5432/agentbot_db

# Stripe (keys loaded from secrets)
STRIPE_PRICE_STARTER=price_1T59bkDiHU0UF7aWOYKaifpc
STRIPE_PRICE_PRO=price_1T59hmDiHU0UF7aWnr74WQ6O
STRIPE_PRICE_SCALE=price_1T2RthDiHU0UF7aW9mobq19y
STRIPE_PRICE_ENTERPRISE=price_1T3SgXDiHU0UF7aW06D9eJEh
STRIPE_PRICE_WHITEGLOVE=price_1T3SiaDiHU0UF7aW9EehdNPj

# Email
RESEND_API_KEY=re_your_production_key
RESEND_FROM=noreply@agentbot.raveculture.xyz

# Backend
BACKEND_API_URL=https://agentbot.raveculture.xyz
# INTERNAL_API_KEY loaded from secret

# App URLs
NEXT_PUBLIC_APP_URL=https://agentbot.raveculture.xyz
NEXT_PUBLIC_API_URL=https://agentbot.raveculture.xyz
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY loaded from secret

# NextAuth
NEXTAUTH_URL=https://agentbot.raveculture.xyz
# NEXTAUTH_SECRET loaded from secret

# Redis
REDIS_URL=redis://redis:6379

# Monitoring & Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_FRONTEND_DSN_HERE@sentry.io/PROJECT_ID
SENTRY_DSN=https://YOUR_BACKEND_DSN_HERE@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production

# GCP Logging (auto-enabled if on GCP)
GOOGLE_CLOUD_PROJECT=raveculture-youtube-api

# Agents
AGENTS_DOMAIN=agents.raveculture.xyz
AGENTS_BASE_PORT=19000
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.2.26
DEFAULT_MODEL=google/gemini-2.0-flash
