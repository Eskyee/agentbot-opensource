# Agentbot - Production Environment Variables
# ⚠️  IMPORTANT: This is a TEMPLATE file
# 
# Before deploying to production:
# 1. Copy this file: cp .env.production .env
# 2. Replace ALL placeholder values with real credentials
# 3. NEVER commit the actual .env file with real credentials
# 4. Use secure random values (e.g., openssl rand -hex 32)
# 
# ALL values marked as "your-*" or "user:pass" MUST be changed!

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=https://api.agentbot.com
NEXT_PUBLIC_AGENTS_DOMAIN=agents.agentbot.com
BACKEND_API_URL=https://api.agentbot.com
BACKEND_API_FALLBACK_URL=http://35.193.69.87:3001
INTERNAL_API_KEY=9f44230308f0b6d9ff5d2e402918ddeb1d4d5e410da2ceeec981af23a9b647e5

# Backend API
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://user:pass@postgres-host:5432/agentbot_db
REDIS_URL=redis://redis-host:6379
ALLOWED_ORIGINS=https://agentbot.com,https://www.agentbot.com
AGENTS_DOMAIN=agents.agentbot.com

# Worker
WORKER_REDIS_URL=redis://redis-host:6379
WORKER_DATABASE_URL=postgres://user:pass@postgres-host:5432/agentbot_db

# Database
POSTGRES_USER=agentbot
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=agentbot_db

# OpenClaw Provisioning
API_SECRET=your-api-secret-here
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
