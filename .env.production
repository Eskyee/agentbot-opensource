# StartClaw - Production Environment Variables
# ⚠️  IMPORTANT: This is a TEMPLATE file
# 
# Before deploying to production:
# 1. Copy this file: cp .env.production .env
# 2. Replace ALL placeholder values with real credentials
# 3. NEVER commit the actual .env file with real credentials
# 4. Use secure random values (e.g., openssl rand -hex 32)
# 
# ALL values marked as "your-*" or "user:pass" MUST be changed!

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=https://api.startclaw.com
NEXT_PUBLIC_AGENTS_DOMAIN=agents.startclaw.com
BACKEND_API_URL=https://api.startclaw.com
INTERNAL_API_KEY=your-secure-key-here

# Backend API
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://user:pass@postgres-host:5432/startclaw_db
REDIS_URL=redis://redis-host:6379
ALLOWED_ORIGINS=https://startclaw.com,https://www.startclaw.com
AGENTS_DOMAIN=agents.startclaw.com

# Worker
WORKER_REDIS_URL=redis://redis-host:6379
WORKER_DATABASE_URL=postgres://user:pass@postgres-host:5432/startclaw_db

# Database
POSTGRES_USER=startclaw
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=startclaw_db

# OpenClaw Provisioning
API_SECRET=your-api-secret-here
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
