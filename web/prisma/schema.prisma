  updated_at         DateTime  @updatedAt

  @@index([enabled], map: "idx_basefm_relays_enabled")
  @@index([status], map: "idx_basefm_relays_status")
}

model mixtapes {
  id              String    @id @default(cuid())
  user_id         String
  title           String
  artist_name     String?
  mux_upload_id   String    @unique
