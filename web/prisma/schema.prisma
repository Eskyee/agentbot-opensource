model JobListing {
  id                      String           @id @default(cuid())
  companyId               String
  title                   String
  description             String           @db.Text
  salaryMin               Int
  salaryMax               Int
  salaryCurrency          String           @default("USD")
  roleType                String
  techStack               String[]
