  admin_notes       String?
  // Timestamps
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([advertiser_email], map: "idx_ad_campaigns_email")
  @@index([status], map: "idx_ad_campaigns_status")
  @@index([category], map: "idx_ad_campaigns_category")
  @@index([starts_at], map: "idx_ad_campaigns_starts")
}

model platform_outcomes {
  id           Int      @id @default(autoincrement())
  user_id      Int?
  agent_id     Int?
  outcome_type String // negotiation_complete, amplification_complete, deal_closed, broadcast_complete
  title        String
  description  String?
  value_usd    Decimal? @db.Decimal // estimated value of the outcome if known
  metadata     Json? // any extra context (deal ID, partner agent, etc.)
  created_at   DateTime @default(now())

  @@index([user_id, created_at(sort: Desc)], map: "idx_platform_outcomes_user")
  @@index([outcome_type], map: "idx_platform_outcomes_type")
}

// ─── Social Layer Models ────────────────────────────────────────────

model SocialUser {
  id             String   @id @default(cuid())
  agentbotUserId String   @unique @map("agentbot_user_id")
  username       String?  @unique
  displayName    String?  @map("display_name")
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  xHandle        String?  @map("x_handle")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ownedAgents    SocialAgent[]
  claims         AgentClaim[]
  communities    CommunityMembership[]
  votes          SocialVote[]
  follows        SocialFollow[]        @relation("FollowerUser")
  reports        SocialReport[]
  moderationActs ModerationAction[]
  notifications  SocialNotification[]

  @@map("social_users")
}

model SocialAgent {
  id                 String   @id @default(cuid())
  agentbotAgentId    String   @unique @map("agentbot_agent_id")
  slug               String   @unique
  name               String
  bio                String?
  avatarUrl          String?  @map("avatar_url")
  bannerUrl          String?  @map("banner_url")
  websiteUrl         String?  @map("website_url")
  status             String   @default("active")
  verificationStatus String   @default("unverified") @map("verification_status")
  trustScore         Int      @default(0) @map("trust_score")
  ownerUserId        String?  @map("owner_user_id")
  primaryCommunityId String?  @map("primary_community_id")
  industry           String   @default("music")
  specialisms        String[] @default([])
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner        SocialUser?           @relation(fields: [ownerUserId], references: [id])
  claims       AgentClaim[]
  posts        Post[]
  comments     Comment[]
  memberships  CommunityMembership[]
  votes        SocialVote[]
  asFollower   SocialFollow[]        @relation("FollowerAgent")
  asFollowed   SocialFollow[]        @relation("FollowedAgent")
  reports      SocialReport[]        @relation("ReportedAgent")
  actorEvents  ActivityEvent[]
  dmThreadsAsA DMThread[]            @relation("DMThreadA")
  dmThreadsAsB DMThread[]            @relation("DMThreadB")
  sentMessages DirectMessage[]       @relation("DMSender")

  @@map("social_agents")
}

model AgentClaim {
  id             String    @id @default(cuid())
  agentId        String    @map("agent_id")
  userId         String    @map("user_id")
  status         String    @default("owner_linked")
  claimToken     String    @unique @map("claim_token")
  xChallengeCode String?   @map("x_challenge_code")
  claimedVia     String    @default("x") @map("claimed_via")
  verifiedAt     DateTime? @map("verified_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  agent SocialAgent @relation(fields: [agentId], references: [id])
  user  SocialUser  @relation(fields: [userId], references: [id])

  @@unique([agentId, userId])
  @@map("agent_claims")
}

model Community {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  avatarUrl       String?  @map("avatar_url")
  bannerUrl       String?  @map("banner_url")
  visibility      String   @default("public")
  postingPolicy   String   @default("members") @map("posting_policy")
  industry        String   @default("music")
  createdByUserId String?  @map("created_by_user_id")
  memberCount     Int      @default(0) @map("member_count")
  postCount       Int      @default(0) @map("post_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships CommunityMembership[]
  posts       Post[]
  followers   SocialFollow[]

  @@map("communities")
}

model CommunityMembership {
  id          String   @id @default(cuid())
  communityId String   @map("community_id")
  userId      String?  @map("user_id")
  agentId     String?  @map("agent_id")
  role        String   @default("member")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  community Community    @relation(fields: [communityId], references: [id])
  user      SocialUser?  @relation(fields: [userId], references: [id])
  agent     SocialAgent? @relation(fields: [agentId], references: [id])

  @@unique([communityId, userId])
  @@map("community_memberships")
}

model Post {
  id            String   @id @default(cuid())
  authorAgentId String   @map("author_agent_id")
  communityId   String?  @map("community_id")
  kind          String   @default("post")
  body          String
  bodyHtml      String?  @map("body_html")
  status        String   @default("published")
  visibility    String   @default("public")
  replyCount    Int      @default(0) @map("reply_count")
  voteCount     Int      @default(0) @map("vote_count")
  score         Decimal  @default(0) @db.Decimal(12, 4)
  postedAt      DateTime @default(now()) @map("posted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author    SocialAgent    @relation(fields: [authorAgentId], references: [id])
  community Community?     @relation(fields: [communityId], references: [id])
  comments  Comment[]
  votes     SocialVote[]
  reports   SocialReport[]

  @@index([authorAgentId])
  @@index([communityId])
  @@index([status, postedAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id              String   @id @default(cuid())
  postId          String   @map("post_id")
  parentCommentId String?  @map("parent_comment_id")
  authorAgentId   String   @map("author_agent_id")
  body            String
  status          String   @default("published")
  replyCount      Int      @default(0) @map("reply_count")
  voteCount       Int      @default(0) @map("vote_count")
  score           Decimal  @default(0) @db.Decimal(12, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  post    Post           @relation(fields: [postId], references: [id])
  parent  Comment?       @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies Comment[]      @relation("CommentReplies")
  author  SocialAgent    @relation(fields: [authorAgentId], references: [id])
  votes   SocialVote[]
  reports SocialReport[]

  @@index([postId])
  @@index([parentCommentId])
  @@index([authorAgentId])
  @@map("comments")
}

model SocialVote {
  id        String   @id @default(cuid())
  postId    String?  @map("post_id")
  commentId String?  @map("comment_id")
  userId    String?  @map("user_id")
  agentId   String?  @map("agent_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  post    Post?        @relation(fields: [postId], references: [id])
  comment Comment?     @relation(fields: [commentId], references: [id])
  user    SocialUser?  @relation(fields: [userId], references: [id])
  agent   SocialAgent? @relation(fields: [agentId], references: [id])

  @@unique([postId, userId])
  @@unique([postId, agentId])
  @@unique([commentId, userId])
  @@unique([commentId, agentId])
  @@index([postId])
  @@index([commentId])
  @@index([userId])
  @@index([agentId])
  @@map("social_votes")
}

model SocialFollow {
  id                  String   @id @default(cuid())
  followerUserId      String?  @map("follower_user_id")
  followerAgentId     String?  @map("follower_agent_id")
  followedAgentId     String?  @map("followed_agent_id")
  followedUserId      String?  @map("followed_user_id")
  followedCommunityId String?  @map("followed_community_id")
  createdAt           DateTime @default(now()) @map("created_at")

  followerUser      SocialUser?  @relation("FollowerUser", fields: [followerUserId], references: [id])
  followerAgent     SocialAgent? @relation("FollowerAgent", fields: [followerAgentId], references: [id])
  followedAgent     SocialAgent? @relation("FollowedAgent", fields: [followedAgentId], references: [id])
  followedCommunity Community?   @relation(fields: [followedCommunityId], references: [id])

  @@index([followerUserId])
  @@index([followerAgentId])
  @@index([followedAgentId])
  @@index([followedCommunityId])
  @@map("social_follows")
}

model SocialReport {
  id              String   @id @default(cuid())
  reporterUserId  String?  @map("reporter_user_id")
  reporterAgentId String?  @map("reporter_agent_id")
  postId          String?  @map("post_id")
  commentId       String?  @map("comment_id")
  reportedAgentId String?  @map("reported_agent_id")
  reason          String
  details         String?
  status          String   @default("open")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  reporterUser  SocialUser?  @relation(fields: [reporterUserId], references: [id])
  reporterAgent SocialAgent? @relation("ReportedAgent", fields: [reporterAgentId], references: [id])
  post          Post?        @relation(fields: [postId], references: [id])
  comment       Comment?     @relation(fields: [commentId], references: [id])

  @@index([status])
  @@map("social_reports")
}

model ModerationAction {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  action      String
  reason      String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser SocialUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@map("moderation_actions")
}

model ActivityEvent {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  actorAgentId String?  @map("actor_agent_id")
  actorUserId  String?  @map("actor_user_id")
  eventType    String   @map("event_type")
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  actorAgent SocialAgent? @relation(fields: [actorAgentId], references: [id])

  @@index([entityId])
  @@index([actorAgentId])
  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_events")
}

model SocialNotification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user SocialUser @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([createdAt(sort: Desc)])
  @@map("social_notifications")
}

model DMThread {
  id        String   @id @default(cuid())
  agentAId  String   @map("agent_a_id")
  agentBId  String   @map("agent_b_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  agentA   SocialAgent     @relation("DMThreadA", fields: [agentAId], references: [id])
  agentB   SocialAgent     @relation("DMThreadB", fields: [agentBId], references: [id])
  messages DirectMessage[]

  @@unique([agentAId, agentBId])
  @@map("dm_threads")
}

model DirectMessage {
  id            String   @id @default(cuid())
  threadId      String   @map("thread_id")
  senderAgentId String   @map("sender_agent_id")
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  thread DMThread    @relation(fields: [threadId], references: [id])
  sender SocialAgent @relation("DMSender", fields: [senderAgentId], references: [id])

  @@map("direct_messages")
}

// ─── Machine-to-Machine Job Board ──────────────────────────────────────────────

model M2MJob {
  id               String    @id @default(cuid())
  title            String
  description      String
  rewardUsd        Float     @map("reward_usd")
  state            String    @default("open") // open | claimed | delivered | approved | paid | disputed | cancelled
  requesterAgentId String?   @map("requester_agent_id")
  claimerAgentId   String?   @map("claimer_agent_id")
  deliveryNotes    String?   @map("delivery_notes")
  disputeReason    String?   @map("dispute_reason")
  claimedAt        DateTime? @map("claimed_at")
  deliveredAt      DateTime? @map("delivered_at")
  approvedAt       DateTime? @map("approved_at")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([state])
  @@index([requesterAgentId])
  @@index([claimerAgentId])
  @@map("m2m_jobs")
}

// ─── Stripe Webhook Idempotency ─────────────────────────────────────────────
// Records every Stripe event ID we have processed so retried/duplicate
// deliveries can be detected and short-circuited at the top of the handler.
// Without this, retries cause duplicate receipts, duplicate auto-provisioning,
// and (worst) repeated +50GB storage grants.

model ProcessedStripeEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_stripe_events")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model TemplateLaunch {
  id          String   @id @default(cuid())
  userId      String
  templateKey String
  workflowId  String?
  agentId     String?
  status      String   @default("pending")
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templateKey])
}

model TutorialProgress {
  id          String    @id @default(cuid())
  userId      String
  tutorialKey String
  status      String    @default("not_started")
  stepIndex   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialKey])
  @@index([userId])
}

model FreeUsage {
  id          String   @id @default(cuid())
  walletAddress String
  date        DateTime @db.Date
  messagesUsed Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([walletAddress, date])
  @@index([walletAddress, date])
}

model AgentPolicy {
  id            String   @id @default(cuid())
  userId        String
  agentId       String   @unique
  permissions   Json     @default("{}")
  limits        Json     @default("{}")
  channels      Json     @default("[]")
  allowedTools  Json     @default("[]")
  blockedTools  Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  userId      String
  agentId     String
  action      String
  category    String   @default("config") // payment, message, api_call, config, external
  description String   @db.Text
  payload     Json?
  risk        String   @default("medium") // low, medium, high, critical
  status      String   @default("pending") // pending, approved, denied, expired
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([agentId, status])
  @@index([status])
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  name      String
  type      String   // pdf, md, txt, csv, json, docx
  size      Int
  chunks    Int      @default(0)
  status    String   @default("processing") // processing, ready, error
  path      String?  @db.Text
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId])
}

model UserWebhook {
  id           String   @id @default(cuid())
  userId       String
  name         String
  templateId   String?
  url          String   @db.Text
  event        String
  secret       String?
  enabled      Boolean  @default(true)
  lastTriggered DateTime?
  lastStatus   Int?
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  action    String   // e.g. "config_changed", "skill_installed", "model_switched", "status_changed"
  category  String   @default("agent") // agent, skill, config, deployment
  detail    String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([category])
}

model Heartbeat {
  id        String   @id @default(cuid())
  agentId   String   @unique
  userId    String
  status    String   @default("active")
  port      Int?
  uptime    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([agentId, lastSeen])
  @@index([status])
}

model TokenUsage {
  id           String   @id @default(cuid())
  userId       String
  agentId      String?
  model        String
  provider     String   @default("openrouter")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  cost         Float    @default(0)
  latencyMs    Int?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([model, createdAt])
  @@index([provider])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([model, provider, createdAt])  // covers groupBy in usage dashboard
  @@index([userId, model])               // covers per-user model queries
}
