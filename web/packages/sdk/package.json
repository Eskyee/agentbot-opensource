{
  "name": "@agentbot/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Agentbot platform — agents, chat, MCP, and x402 payments",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "import": "./dist/x402.js",
      "require": "./dist/x402.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agentbot",
    "ai",
    "agents",
    "mcp",
    "x402",
    "payments",
    "openclaw"
  ],
  "author": "Agentbot",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@x402/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Eskyee/agentbot",
    "directory": "web/packages/sdk"
  }
}
