{
  "name": "@agentbot/web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "."
  ],
  "scripts": {
    "demo": "next dev --hostname 127.0.0.1 --port 3007",
    "dev": "next dev",
    "build": "npx prisma generate && NODE_OPTIONS=\"--max-old-space-size=3072\" next build && node scripts/ensure-routes-manifest.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 100",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "clean": "rm -rf .next",
    "design:check": "grep -rn 'gray-\\|purple-' app/ --include=\"*.tsx\" | grep -v node_modules || echo 'Design check passed'",
    "design:fix": "find app -name '*.tsx' -exec sed -i '' 's/bg-gray-/bg-zinc-/g; s/text-gray-/text-zinc-/g; s/border-gray-/border-zinc-/g; s/hover:bg-gray-/hover:bg-zinc-/g; s/bg-purple-/bg-orange-/g; s/text-purple-/text-orange-/g; s/border-purple-/border-orange-/g; s/hover:bg-purple-/hover:bg-orange-/g' {} +"
  },
