    "@tanstack/react-query": "^5.100.11",
    "@types/pg": "^8.20.0",
    "@types/three": "^0.184.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
