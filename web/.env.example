
# Local database / auth
# If you use `docker compose up -d` from `web/`, this is the matching local Postgres URL.
DATABASE_URL=postgresql://agentbot:agentbot_local_dev@localhost:5432/agentbot
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Web Push Notifications (VAPID keys)
# Generate with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# X API / social agents
# App-level credentials for X-native social workflows
X_API_KEY=your_x_api_key
X_API_KEY_SECRET=your_x_api_key_secret
X_API_BEARER_TOKEN=your_x_api_bearer_token
X_API_CLIENT_ID=your_x_api_client_id
X_API_CLIENT_SECRET=your_x_api_client_secret
X_API_CALLBACK_URL=http://localhost:3000/api/x/callback
X_API_SIGNAL_QUERY=(agentbot OR openclaw OR basefm OR x402 OR ai agents OR social agents) lang:en -is:retweet
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_AGENT_ID=your_anthropic_agent_id
ANTHROPIC_ENVIRONMENT_ID=your_anthropic_environment_id
AGENTBOT_X_MCP_URL=https://your-x-mcp.example.com/mcp
AGENTBOT_GITHUB_MCP_URL=https://your-github-mcp.example.com/mcp
AGENTBOT_NOTION_MCP_URL=https://your-notion-mcp.example.com/mcp
AGENTBOT_SLACK_MCP_URL=https://your-slack-mcp.example.com/mcp
AGENTBOT_BANKR_MCP_URL=https://your-bankr-mcp.example.com/mcp

# baseFM relay / destinations
BASEFM_FIRST_PARTY_URL=https://agentbot.sh/basefm/live
BASEFM_SPACE_URL=https://basefm.space
BASEFM_SPACE_PROBE_URL=https://basefm.space
BASEFM_YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
BASEFM_YOUTUBE_STREAM_KEY=your_youtube_stream_key
BASEFM_YOUTUBE_VIEWER_URL=https://youtube.com/@yourchannel/live

# MPP / Tempo (Agent payments with x402)
# Tempo wallet private key - get from `tempo wallet keys`
MPP_PRIVATE_KEY=0xYOUR_TEMPO_PRIVATE_KEY_HERE
# Agent wallets JSON array (created via /api/agent/mpp)
MPP_AGENT_WALLETS=[]

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key_here
# Required for /api/webhooks/resend — the webhook Signing Secret from the Resend
# dashboard (Webhooks → your endpoint → Signing Secret). Without it the handler
# fails closed (HTTP 503) and Resend will disable the webhook.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# x402 Payments (USDC on Base)
# Your wallet address to receive payments
X402_PAY_TO=0xYOUR_WALLET_ADDRESS_HEREYOUR_WALLET_ADDRESS_HERE
# Gateway URL (Railway production)
X402_GATEWAY_URL=https://YOUR_SERVICE_URL
# Optional: custom facilitator URL — when set, escrow `release` settles the held
# USDC on-chain via the facilitator's /settle endpoint (and verifies signatures
# via /verify). Unset = escrow still works; settlement is done manually.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Optional: bearer token if your facilitator requires auth (e.g. a CDP endpoint)
X402_FACILITATOR_KEY=

# World ID / AgentKit
# Get these from https://developer.world.org when adding generic IDKit flows.
WORLD_APP_ID=app_your_world_app_id
WORLD_RP_ID=rp_your_relying_party_id
# Backend-only signing key. Never expose this to the browser.
RP_SIGNING_KEY=your_world_rp_signing_key
# Optional overrides for AgentKit AgentBook lookup and hosted relay.
WORLD_CHAIN_RPC_URL=
AGENTKIT_RELAY_URL=https://x402-worldchain.vercel.app

# Bankr API (for crypto trading)
BANKR_API_KEY=bk_your_bankr_api_key_here
BANKR_API_URL=https://api.bankr.bot

# AI Gateway / OpenGateway upstreams
AI_GATEWAY_API_KEY=your_ai_gateway_key
OPENROUTER_API_KEY=your_openrouter_key
AGENTBOT_GATEWAY_UPSTREAM_BASE_URL=
AGENTBOT_GATEWAY_UPSTREAM_API_KEY=

# Coinbase CDP (Wallet Integration)
# Get your API keys from https://portal.cdp.coinbase.com/
CDP_API_KEY_NAME=your-api-key-name
CDP_API_KEY_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----YOUR_PRIVATE_KEY-----END EC PRIVATE KEY-----

# Wallet Encryption Key (32 bytes hex)
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=your-32-byte-hex-key-for-encrypting-wallets
SOUL_SERVICE_URL=https://YOUR_SERVICE_URL

# Agentbot backend
BACKEND_API_URL=http://localhost:3001
INTERNAL_API_KEY=your_internal_api_key

# Managed OpenClaw deployment
# Required in Vercel production for one-click Railway provisioning
RAILWAY_API_KEY=your_railway_api_key
RAILWAY_TOKEN_TYPE=account
RAILWAY_PROJECT_ID=your_railway_project_id
RAILWAY_ENVIRONMENT_ID=your_railway_environment_id
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token

# Optional but recommended overrides so the frontend never falls back to stale hosts
OPENCLAW_GATEWAY_URL=https://YOUR_SERVICE_URL
NEXT_PUBLIC_OPENCLAW_GATEWAY_URL=https://YOUR_SERVICE_URL
NEXT_PUBLIC_OPENCLAW_CONTROL_UI_URL=https://YOUR_SERVICE_URL

# Optional: allow users to attach managed agents to their own Tailscale tailnet.
# Requires OPENCLAW_IMAGE to reference an image with Tailscale binaries and
# /usr/local/bin/agentbot-tailscale-start.
# See ../docs/tailscale-agents.md.
OPENCLAW_TAILSCALE_ENABLED=false
