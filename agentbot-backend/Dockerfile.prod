FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY agentbot-backend/package*.json ./agentbot-backend/

RUN cd agentbot-backend && npm ci && npm run build

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init docker-cli

COPY --from=builder /app/agentbot-backend/dist ./dist
COPY --from=builder /app/agentbot-backend/node_modules ./node_modules
COPY --from=builder /app/agentbot-backend/package*.json ./

EXPOSE 3001

ENTRYPOINT ["dumb-init", "--"]

CMD ["node", "dist/index.js"]
