{
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "sk-or-v1-fake"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/google/gemini-2.0-flash-exp:free"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "123456:fake-telegram-token",
      "allowFrom": [
        "123456"
      ],
      "dmPolicy": "allowlist"
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}