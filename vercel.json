{
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/.next",
  "installCommand": "cd web && npm install",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "production": true,
      "main": true
    }
  },
  "github": {
    "silent": true,
    "autoAlias": true
  }
}
