{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rootDirectory": "web",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feat-*": false,
      "fix-*": false,
      "chore-*": false,
      "dev-*": false
    }
  },
  "regions": ["iad1", "lhr1"],
  "functionFailoverRegions": ["sfo1"],
  "fluid": true,
  "installCommand": "npm install --include=dev --legacy-peer-deps --no-audit --fund=false",
  "buildCommand": "NEXT_PUBLIC_DEMO_MODE=true npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --name-only HEAD~1 | grep -qvE '^docs/|^\\.github/|^README\\.md$|^LICENSE$' && exit 1 || exit 0",
  "functions": {
    "app/api/sandbox/route.ts": {
      "maxDuration": 300
    },
    "app/api/browser/route.ts": {
      "maxDuration": 120
    },
    "app/api/generate-video/route.ts": {
      "maxDuration": 300
    },
    "app/api/generate-music/route.ts": {
      "maxDuration": 300
    },
    "app/api/provision/route.ts": {
      "maxDuration": 300
    },
    "app/api/workflows/run/route.ts": {
      "maxDuration": 300
    },
    "app/api/bitcoin/liquid/route.ts": {
      "maxDuration": 30
    },
    "app/api/devices/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/x-publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/x-monitor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/blog-daily",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/moltx-weekly",
      "schedule": "0 9 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/docs", "destination": "https://raveculture.mintlify.app", "permanent": false }
  ]
}
