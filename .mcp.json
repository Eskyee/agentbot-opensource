{
  "mcpServers": {
    "blacksmith": {
      "command": "npx",
      "args": ["-y", "blacksmith-mcp"],
      "env": {
        "BLACKSMITH_ORG": "Eskyee"
      }
    },
    "railway": {
      "command": "npx",
      "args": ["-y", "@railway/mcp-server"]
    },
    "resend": {
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}"
      }
    }
  }
}
