# Stripe Price IDs - All 5 Plans
STRIPE_PRICE_STARTER=price_1T59bkDiHU0UF7aWOYKaifpc
STRIPE_PRICE_PRO=price_1T59hmDiHU0UF7aWnr74WQ6O
STRIPE_PRICE_SCALE=price_1T2RthDiHU0UF7aW9mobq19y
STRIPE_PRICE_ENTERPRISE=price_1T3SgXDiHU0UF7aW06D9eJEh
STRIPE_PRICE_WHITEGLOVE=price_1T3SiaDiHU0UF7aW9EehdNPj

# ============================================================================
# Frontend Configuration
# ============================================================================
NEXT_PUBLIC_APP_URL=https://agentbot.raveculture.xyz
NEXT_PUBLIC_API_URL=https://api.agentbot.raveculture.xyz

# ============================================================================
# Database Configuration - Production PostgreSQL
# ============================================================================
DATABASE_URL=postgresql://agentbot:PASSWORD@DATABASE_HOST:5432/agentbot_db
POSTGRES_USER=agentbot
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=agentbot_db

# ============================================================================
# Redis Cache Configuration
# ============================================================================
REDIS_URL=redis://REDIS_HOST:6379

# ============================================================================
# Backend API Configuration
# ============================================================================
NODE_ENV=production
PORT=3001
BACKEND_API_URL=https://api.agentbot.raveculture.xyz
INTERNAL_API_KEY=GENERATE_RANDOM_HEX_STRING_32_CHARS

# ============================================================================
# Email Configuration (Optional - for payment receipts)
# ============================================================================
# Choose one provider:

# Option 1: Resend (Recommended)
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
RESEND_FROM=noreply@agentbot.raveculture.xyz

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY
# SENDGRID_FROM=noreply@agentbot.raveculture.xyz

# Option 3: Custom SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@agentbot.raveculture.xyz

# ============================================================================
# Authentication
# ============================================================================
NEXTAUTH_SECRET=GENERATE_RANDOM_HEX_STRING_32_CHARS
NEXTAUTH_URL=https://agentbot.raveculture.xyz

# OAuth Providers (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# Agents Configuration
# ============================================================================
AGENTS_DOMAIN=agents.agentbot.raveculture.xyz
AGENTS_BASE_PORT=19000
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.2.26
DEFAULT_MODEL=google/gemini-2.0-flash
DEFAULT_AGENT_PROVIDER=openrouter

# ============================================================================
# AI Provider Keys
# ============================================================================
# Users can provide their own, but these are fallback/defaults
# GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key

# ============================================================================
# Application Settings
# ============================================================================
PRIVATE_MODE=false
INVITE_REQUIRED=false
DATA_DIR=/opt/agentbot/data

# ============================================================================
# Logging & Monitoring
# ============================================================================
LOG_LEVEL=info
ENABLE_MONITORING=true

# ============================================================================
# IMPORTANT NOTES FOR PRODUCTION
# ============================================================================
# 1. Replace DATABASE_HOST with your PostgreSQL server IP/domain
# 2. Replace REDIS_HOST with your Redis server IP/domain
# 3. Generate random 32-char hex strings for secrets:
#    $ openssl rand -hex 32
# 4. Update email provider credentials
# 5. Configure SSL/TLS certificates
# 6. Update STRIPE_WEBHOOK_SECRET after webhook setup in Stripe
# 7. Never commit this file with real credentials to git
# 8. Use secure vault/secrets manager in production
