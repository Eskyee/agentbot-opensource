NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_51PKs3vDiHU0UF7aWN7hoWzcgczV6CHnY9FAffmfxroxEnJRaaMwNj2yu2jvpxX8UqPnHlyJo0Li4A8rOb5qePbXh00jZc8KEfB
