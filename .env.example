# ━━━ Agentbot Configuration ━━━

# MiMo API key (required) — get from https://mimo.xiaomi.com
MIMO_API_KEY=

# OpenRouter API key (fallback) — get from https://openrouter.ai/keys  
OPENROUTER_API_KEY=

# Telegram bot token (optional) — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Stripe (optional — for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App URL (auto-detected for local)
NEXT_PUBLIC_APP_URL=http://localhost:3010
