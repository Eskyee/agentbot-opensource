# Required environment variables for local Docker Compose
# Copy to .env and fill in your values
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional managed-agent Tailscale support.
# Build/deploy an OpenClaw image that includes agentbot-tailscale-start, such as
# agentbot-backend/docker/Dockerfile.agent or gateway/Dockerfile, then point OPENCLAW_IMAGE at it.
# Users pass their own auth key at provision time; do not set a shared user key here.
# See docs/tailscale-agents.md.
OPENCLAW_TAILSCALE_ENABLED=false
